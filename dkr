        def count_text(self) -> str:
            if self.view == "containers":
                cs = [c for c in self.containers if not self.scope or c.project == self.scope]
                return f"{sum(c.running for c in cs)}/{len(cs)} running"
            items = [r.res for r in self.rows if r.res]
            if not self.res.loaded:
                return "loading…"
            total = sum(r.size for r in items)
            unused = sum(1 for r in items if not r.in_use)
            s = f"{len(items)} {self.view}"
            if total:
                s += f"  ·  {fmt_size(total)}"
            return s + (f"  ·  {unused} unused" if unused else "")

        def update_tabbar(self) -> None:
            t = Text(" ")
            for i, name in enumerate(self.panes):
                if i:
                    t.append("   ")
                t.append(name, style=f"bold {ACCENT}" if name == self.pane else MUTED)
            t.append(" ")
            self.query_one("#tabbar", Static).update(rule(t, align="left"))

        def update_status(self) -> None:
            if self._flash and time.monotonic() < self._flash[1]:
                self.query_one("#status", Static).update(self._flash[0])
                return
            self._flash = None
            t = Text(no_wrap=True, overflow="ellipsis", style=MUTED)
            t.append(f"{self.engine.name} {self.version}")
            if self.cwd_project:
                t.append(f"  ·  {tilde(self.cwd_project.working_dir, 40)}")
            if not self.show_stopped:
                t.append("  ·  hiding stopped")
            if not self.show_stats:
                t.append("  ·  stats off")
            self.query_one("#status", Static).update(t)

        def notify(self, message: str, *, title: str = "", severity: str = "information",
                   timeout: float | None = None, markup: bool = True) -> None:
            """Messages go to the status line instead of pop-up toasts."""
            icon, style = {"error": ("✗", BAD), "warning": ("!", WARN)}.get(severity, ("✓", OK))
            msg = " ".join(f"{title + ': ' if title else ''}{message}".split())
            t = Text(no_wrap=True, overflow="ellipsis")
            t.append(f"{icon} ", style=style)
            t.append(msg, style=style if severity == "error" else "")
            secs = timeout or 3
            self._flash = (t, time.monotonic() + secs)
            self.update_status()
            self.set_timer(secs + 0.05, self.update_status)

        # ── data loading ──
        @work(thread=True, group="static")
        def load_static(self) -> None:
            v = engine_version(self.engine)
            p = load_cwd_project(self.engine)
            self.call_from_thread(self._set_static, v, p)

        def _set_static(self, version: str, project: Project | None) -> None:
            self.version, self.cwd_project = version, project
            self._signature = None
            self.update_chrome()
            self.refresh_data()

        @work(thread=True, exclusive=True, group="refresh")
        def refresh_data(self) -> None:
            try:
                containers = list_containers(self.engine)
                res = load_resources(self.engine, containers) if self.view != "containers" else None
            except Exception as e:  # daemon down etc.
                self.call_from_thread(self.notify, str(e), severity="error", timeout=4)
                return
            self.call_from_thread(self._apply, containers, res)

        @work(thread=True, exclusive=True, group="stats")
        def refresh_stats(self) -> None:
            if not self.show_stats or self.view != "containers" or not any(c.running for c in self.containers):
                return
            s = list_stats(self.engine)
            self.call_from_thread(self._apply_stats, s)

        def _apply_stats(self, stats) -> None:
            self.stats = stats
            self._apply(self.containers)

        def _apply(self, containers: list[Container], res: Resources | None = None) -> None:
            first_load = not self._started and containers
            self._started = self._started or bool(containers)
            self.containers = containers
            if res is not None:
                self.res = res
            if first_load and self.show_stats:
                self.refresh_stats()
            self.by_id = {c.id: c for c in containers}
            self.projects = collect_projects(containers, self.cwd_project)
            self.rows = self.compute_rows()
            self.row_by_key = {r.key: r for r in self.rows}
            self.update_chrome()
            self.render_table()

        def compute_rows(self) -> list[Row]:
            if self.view == "containers":
                rows: list[Row] = []
                for r in build_rows(self.containers, self.projects, self.show_stopped, self.filter_text, self.scope):
                    if r.kind == "group" and rows:
                        rows.append(Row(f"sp:{r.key}", "spacer"))  # breathing room between groups
                    rows.append(r)
                return rows
            items = getattr(self.res, self.view)
            return resource_rows(scope_resources(items, self.scope, self.containers), self.filter_text)

        def render_table(self) -> None:
            t = self.query_one(DataTable)
            keep = self.selected_key
            stats = self.stats if self.show_stats else {}
            cells = {r.key: row_cells(r, stats, r.key == keep) for r in self.rows}
            sig = (self.view, tuple((k, tuple((c.plain, str(c.style)) for c in v)) for k, v in cells.items()))
            if sig == self._signature:
                return
            self._signature = sig
            existing = [rk.value for rk in t.rows]
            cols = [ck.value for ck in t.columns]
            if existing and existing == [r.key for r in self.rows]:
                # Same rows: update cells in place (no flicker; cursor and log stream untouched).
                for r in self.rows:
                    for col, val in zip(cols, cells[r.key], strict=False):
                        t.update_cell(r.key, col, val, update_width=True)
                return
            t.clear()
            for r in self.rows:
                t.add_row(*cells[r.key][:len(cols)], key=r.key)
            if not self.rows:
                what = "containers" if self.view == "containers" else self.view
                msg = "Loading…" if self.view != "containers" and not self.res.loaded else (
                    f"No {what}" + (f" matching “{self.filter_text}”" if self.filter_text else "")
                    + (f" in stack {self.scope} — press g to see all" if self.scope else "") + ".")
                self.query_one("#details-body", Static).update(Text(msg, style=MUTED))
                self.selected_key = None
                return
            first = next((i for i, r in enumerate(self.rows) if r.kind not in ("group", "spacer")), 0)
            target = first
            if keep:
                with contextlib.suppress(RowDoesNotExist):
                    target = t.get_row_index(keep)
            t.move_cursor(row=target, animate=False)

        # ── selection → details / logs ──
        @property
        def current(self) -> Row | None:
            return self.row_by_key.get(self.selected_key or "")

        @on(DataTable.RowSelected)
        def _selected(self) -> None:
            self.action_pane("details")

        @on(DataTable.RowHighlighted)
        def _highlighted(self, event: DataTable.RowHighlighted) -> None:
            # Read the cursor *now*, not the event: a table rebuild queues a transient highlight of
            # row 0 before the cursor is restored, which would otherwise restart the log stream.
            t = self.query_one(DataTable)
            if not t.row_count:
                return
            idx = t.cursor_row
            key = t.coordinate_to_cell_key(t.cursor_coordinate).row_key.value
            if key.startswith("sp:"):  # skip spacer rows in the direction of travel
                step = 1 if idx >= self._last_index else -1
                nxt = idx + step if 0 <= idx + step < t.row_count else idx - step
                t.move_cursor(row=nxt, animate=False)
                return
            self._last_index = idx
            if key == self.selected_key:
                return
            prev, self.selected_key = self.selected_key, key
            stats = self.stats if self.show_stats else {}
            for k, on_ in ((prev, False), (key, True)):
                if k and k in self.row_by_key:
                    with contextlib.suppress(Exception):
                        t.update_cell(k, "dot", row_cells(self.row_by_key[k], stats, on_)[0])
            self._signature = None
            if self._detail_timer:
                self._detail_timer.stop()
            self._detail_timer = self.set_timer(0.15, self.show_selected)

        def show_selected(self) -> None:
            row = self.current
            if not row:
                return
            self.load_details(row)
            if self.view == "containers":
                self.stream_logs(row)

        @work(thread=True, exclusive=True, group="details")
        def load_details(self, row: Row) -> None:
            data = {}
            if row.kind == "container":
                data = inspect(self.engine, "container", row.container.id)
            elif row.res:
                data = inspect(self.engine, row.kind, row.res.id if row.kind != "volume" else row.res.id)
            self.call_from_thread(self._show_details, row, data)

        def _show_details(self, row: Row, data: dict) -> None:
            if row.key != self.selected_key:
                return
            self.query_one("#details-body", Static).update(details_renderable(row, data, self))
            raw = data or (row.project.services.get(row.service, {}) if row.project and row.service else {})
            if row.kind == "group" and row.project:
                raw = {"name": row.project.name, "working_dir": row.project.working_dir,
                       "config_files": row.project.config_files, "services": row.project.services or None}
            self.query_one("#inspect-body", Static).update(
                Syntax(json.dumps(raw, indent=2, default=str), "json", theme="ansi_dark", background_color="default"))

        @work(exclusive=True, group="logs")
        async def stream_logs(self, row: Row) -> None:
            log = self.query_one(RichLog)
            log.clear()
            if row.kind == "container":
                cmd = [self.engine.name, "logs", "-f", "--tail", "300", row.container.id]
            elif row.kind == "group" and row.project:
                base, _ = compose_base(self.engine, row.project)
                cmd = base + ["logs", "-f", "--tail", "50"]
            else:
                log.write(Text("Not created yet — press U to bring it up.", style=MUTED))
                return
            proc = await asyncio.create_subprocess_exec(*cmd, stdout=asyncio.subprocess.PIPE,
                                                        stderr=asyncio.subprocess.STDOUT,
                                                        stdin=asyncio.subprocess.DEVNULL)
            try:
                assert proc.stdout
                while True:
                    line = await proc.stdout.readline()
                    if not line:
                        break
                    log.write(Text.from_ansi(line.decode(errors="replace").rstrip("\n")))
            finally:
                if proc.returncode is None:
                    proc.kill()

        # ── view actions ──
        def action_view(self, view: str) -> None:
            if view == self.view:
                return
            self.view = view
            self.selected_key = None
            self._signature = None
            self.workers.cancel_group(self, "logs")
            self.query_one(RichLog).clear()
            if self.pane not in self.panes:
                self.action_pane("details")
            self.setup_columns()
            self._apply(self.containers)  # immediate (possibly stale) render…
            self.refresh_data()  # …then fresh data incl. images/volumes/networks

        def action_toggle_scope(self) -> None:
            if not self.cwd_project:
                return self.notify("Not inside a compose project — already showing everything", severity="warning")
            self.scoped = not self.scoped
            self._apply(self.containers)

        def action_pane(self, name: str) -> None:
            if name not in self.panes:
                return
            self.pane = name
            self.query_one(ContentSwitcher).current = name
            self.update_tabbar()

        def action_cycle_pane(self, step: int = 1) -> None:
            p = self.panes
            self.action_pane(p[(p.index(self.pane) + step) % len(p)] if self.pane in p else p[0])

        def action_zoom(self) -> None:
            self.screen.toggle_class("zoom")

        def action_more(self) -> None:
            self.show_more = not self.show_more
            self.update_chrome()

        def action_filter(self) -> None:
            self.query_one("#filter", Input).focus()

        @on(Input.Changed, "#filter")
        def _filter_changed(self, event: Input.Changed) -> None:
            self.filter_text = event.value
            self._apply(self.containers)

        @on(Input.Submitted, "#filter")
        def _filter_done(self) -> None:
            self.query_one(DataTable).focus()

        def action_escape(self) -> None:
            if self.screen.has_class("zoom"):
                self.screen.remove_class("zoom")
                return
            f = self.query_one("#filter", Input)
            if f.value or f.has_focus:
                f.value = ""
                self.query_one(DataTable).focus()

        def action_toggle_stopped(self) -> None:
            self.show_stopped = not self.show_stopped
            self._apply(self.containers)

        def action_toggle_stats(self) -> None:
            self.show_stats = not self.show_stats
            self._apply(self.containers)
            if self.show_stats:
                self.refresh_stats()

        # ── running things ──
        @work(thread=True)
        def bg(self, cmd: list[str], verb: str, cwd: str | None = None) -> None:
            self.call_from_thread(self.notify, f"{verb}…", timeout=60)
            t0 = time.monotonic()
            r = run(cmd, timeout=180, cwd=cwd)
            if r.returncode == 0:
                self.call_from_thread(self.notify, f"{verb}  ({time.monotonic() - t0:.1f}s)", timeout=3)
            else:
                self.call_from_thread(self.notify, (r.stderr or r.stdout).strip()[-300:] or "failed",
                                      title=verb, severity="error", timeout=8)
            self.call_from_thread(self.refresh_data)

        def foreground(self, cmds: list[list[str]], cwd: str | None = None, pause: str = "error") -> None:
            """Suspend the TUI and run commands attached to the real terminal (progress bars, TTY)."""
            con = Console()
            rc = 0
            with self.suspend():
                for cmd in cmds:
                    con.print()
                    con.print(Text("› ", style=ACCENT) + Text(" ".join(cmd), style=MUTED))
                    con.print()
                    try:
                        rc = subprocess.call(cmd, cwd=cwd)
                    except KeyboardInterrupt:
                        rc = 130
                        break
                    if rc != 0:
                        break
                if pause == "always" or (pause == "error" and rc not in (0, 130)):
                    con.print()
                    con.print(Text("✓ done" if rc == 0 else f"✗ exit {rc}", style=OK if rc == 0 else BAD)
                              + Text("  ·  press enter to return", style=MUTED))
                    with contextlib.suppress(EOFError, KeyboardInterrupt):
                        input()
            self.refresh_data()

        def _target_project(self) -> Project | None:
            row = self.current
            if self.view == "containers" and row and row.project:
                return row.project
            if self.view == "containers" and row and row.container and row.container.project:
                return self.projects.get(row.container.project)
            return self.cwd_project

        def _need_containers(self) -> bool:
            if self.view != "containers":
                self.notify("That works on containers — press 1", severity="warning")
                return False
            return True

        def _container_action(self, verb: str) -> None:
            row = self.current
            if not self._need_containers() or not row:
                return
            if row.kind == "container":
                self.bg([self.engine.name, verb, row.container.id], f"{verb} {row.label.strip()}")
            elif row.kind == "service" and verb in ("start", "restart"):
                self.action_up_service()
            elif row.kind == "group" and row.project:
                base, cwd = compose_base(self.engine, row.project)
                self.bg(base + [verb], f"{verb} {row.project.name}", cwd)
            else:
                self.notify("Nothing to do for this row", severity="warning")

        def action_start(self) -> None:
            self._container_action("start")

        def action_stop(self) -> None:
            self._container_action("stop")

        def action_restart(self) -> None:
            self._container_action("restart")

        def action_remove(self) -> None:
            row = self.current
            if not row:
                return
            e = self.engine.name
            if row.kind == "group" and row.project:
                return self.action_down()
            if row.kind == "container":
                c = row.container
                return self._confirm(Text.assemble("Force-remove container ", (c.name, "bold"), "?"),
                                     lambda: self.bg([e, "rm", "-f", c.id], f"removed {c.name}"))
            if not row.res:
                return
            r = row.res
            if r.kind == "network" and r.extra.get("builtin"):
                return self.notify(f"{r.name} is a built-in network", severity="warning")
            if r.used_by or r.extra.get("elsewhere"):
                who = names_preview(r.used_by, 3) or "containers in other stacks"
                return self.notify(f"{r.name} is in use by {who}", severity="warning")
            msg = Text.assemble(f"Remove {r.kind} ", (r.name, "bold"), "?")
            if r.kind == "volume":
                msg.append(f"\nThis deletes the data in it{' (' + fmt_size(r.size) + ')' if r.size else ''}. "
                           "It can't be undone.", style=WARN)
            elif r.kind == "image" and r.size:
                msg.append(f"\nFrees about {fmt_size(r.size)}.", style=MUTED)
            cmd = {"image": [e, "image", "rm", r.id], "volume": [e, "volume", "rm", r.id],
                   "network": [e, "network", "rm", r.id]}[r.kind]
            self._confirm(msg, lambda: self.bg(cmd, f"removed {r.name}"))

        def _confirm(self, message: Text, then) -> None:
            self.push_screen(Confirm(message), lambda ok: then() if ok else None)

        def action_exec(self) -> None:
            row = self.current
            if not self._need_containers():
                return
            if not row or row.kind != "container":
                return self.notify("Select a container to exec into", severity="warning")
            if not row.container.running:
                return self.notify(f"{row.container.name} isn't running", severity="warning")
            shell = "if command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi"
            self.foreground([[self.engine.name, "exec", "-it", row.container.id, "sh", "-c", shell]])

        def _compose(self, args: list[str], service_scoped: bool = False, pause: str = "error") -> None:
            p = self._target_project()
            if not p:
                return self.notify("No compose project here or selected", severity="warning")
            base, cwd = compose_base(self.engine, p)
            row = self.current
            if service_scoped and self.view == "containers" and row and row.service and row.kind != "group":
                args = args + [row.service]
            self.foreground([base + args], cwd, pause)

        def action_up(self) -> None:
            self._compose(["up", "-d"])

        def action_up_service(self) -> None:
            row = self.current
            if not self._need_containers():
                return
            if not row or not row.service:
                return self.notify("Select a compose service", severity="warning")
            self._compose(["up", "-d"], service_scoped=True)

        def action_build(self) -> None:
            self._compose(["build"], service_scoped=True, pause="always")

        def action_pull(self) -> None:
            row = self.current
            if self.view == "images":
                if not row or not row.res or row.res.name == "<untagged>":
                    return self.notify("Select a tagged image to pull", severity="warning")
                return self.foreground([[self.engine.name, "pull", row.res.name]])
            self._compose(["pull"], service_scoped=True)

        def action_down(self) -> None:
            p = self._target_project()
            if not p:
                return self.notify("No compose project here or selected", severity="warning")
            base, cwd = compose_base(self.engine, p)
            msg = Text.assemble("compose down ", (p.name, "bold"), "?\n",
                                ("Stops and removes its containers and networks. Volumes are kept.", MUTED))
            self._confirm(msg, lambda: self.foreground([base + ["down"]], cwd))

        # ── clean up ──
        def action_prune(self) -> None:
            self.notify("Measuring what can be cleaned up…", timeout=30)
            self._load_prune()

        @work(thread=True, exclusive=True, group="prune")
        def _load_prune(self) -> None:
            try:
                containers = list_containers(self.engine)
                res = load_resources(self.engine, containers)
            except Exception as e:
                self.call_from_thread(self.notify, str(e), severity="error", timeout=5)
                return
            plan = build_prune_plan(self.engine, containers, res)
            self.call_from_thread(self._show_prune, plan)

        def _show_prune(self, plan: list[PruneItem]) -> None:
            self._flash = None
            self.update_status()
            self.push_screen(Prune(plan), self._prune_chosen)

        def _prune_chosen(self, chosen: list[PruneItem] | None) -> None:
            if not chosen:
                return
            if any(c.key == "images" for c in chosen):  # `image prune -a` already covers dangling ones
                chosen = [c for c in chosen if c.key != "dangling"]
            msg = Text("This will run:\n\n", style="bold")
            for it in chosen:
                msg.append("  " + " ".join(it.cmd) + "\n", style="")
                if it.warn:
                    msg.append(f"  ⚠ {it.warn}\n", style=WARN)
            self._confirm(msg, lambda: self.foreground([it.cmd for it in chosen], pause="always"))

    return Dkr()


def tui_main(engine: Engine, start_prune: bool = False) -> None:
    make_app(engine, start_prune).run()


def details_renderable(row: Row, data: dict, app) -> Group | Text:
    grid = Table.grid(padding=(0, 3))
    grid.add_column(style=MUTED, no_wrap=True)
    grid.add_column()

    def hint(*pairs: tuple[str, str]) -> Text:
        t = Text("\n")
        for i, (k, label) in enumerate(pairs):
            if i:
                t.append("  ·  ", style=MUTED)
            t.append(k)
            t.append(f" {label}", style=MUTED)
        return t

    def used(r: Resource) -> Text:
        others = r.extra.get("elsewhere", 0)
        if r.used_by:
            t = Text("\n".join(r.used_by))
        elif r.extra.get("count") or others:
            t = Text(f"{r.extra.get('count') or others} container(s)")
        else:
            return Text("nothing — safe to remove", style=MUTED)
        if others and r.used_by:
            t.append(f"\n+{others} in other stacks (press g)", style=MUTED)
        return t

    if row.kind == "group":
        p = row.project
        if not p:
            return Text("Containers not managed by compose.", style=MUTED)
        grid.add_row("project", Text(p.name, style="bold"))
        grid.add_row("directory", tilde(p.working_dir) or "—")
        grid.add_row("files", "\n".join(tilde(f) for f in p.config_files) or "—")
        grid.add_row("containers", f"{row.running}/{row.total} running")
        if p.services:
            grid.add_row("services", ", ".join(p.services))
        return Group(grid, hint(("s x r", "whole project"), ("u", "up"), ("D", "down"), ("b", "build"),
                                ("p", "pull"), ("l", "project logs")))
    if row.kind == "service":
        svc = row.project.services.get(row.service, {}) if row.project else {}
        grid.add_row("service", Text(row.service or "", style="bold"))
        grid.add_row("state", Text("not created", style=MUTED))
        grid.add_row("image", str(svc.get("image") or ("build " + str((svc.get("build") or {}).get("context", "")))))
        ports = [f"{p.get('published', '')}→{p.get('target', '')}" for p in svc.get("ports", []) if isinstance(p, dict)]
        if ports:
            grid.add_row("ports", "  ".join(ports))
        return Group(grid, hint(("U", f"compose up -d {row.service}"), ("b", "build")))

    if row.kind == "image":
        r = row.res
        grid.add_row("image", Text(r.name, style="bold"))
        grid.add_row("id", r.id)
        tags = data.get("RepoTags") or []
        if len(tags) > 1:
            grid.add_row("tags", "\n".join(tags))
        size = fmt_size(r.extra.get("total") or r.size)
        if r.extra.get("total", 0) > r.size > 0:
            size += f"   ({fmt_size(r.size)} unique to this image)"
        grid.add_row("size", size)
        grid.add_row("created", f"{str(data.get('Created', ''))[:19].replace('T', ' ')}   {short_ago(r.created)}")
        cfg = data.get("Config") or {}
        if data.get("Architecture"):
            grid.add_row("platform", f"{data.get('Os', '')}/{data.get('Architecture')}")
        if cfg.get("Entrypoint") or cfg.get("Cmd"):
            runs = " ".join((cfg.get("Entrypoint") or []) + (cfg.get("Cmd") or []))
            grid.add_row("runs", Text(runs, overflow="fold"))
        if cfg.get("ExposedPorts"):
            grid.add_row("exposes", "  ".join(p.removesuffix("/tcp") for p in cfg["ExposedPorts"]))
        grid.add_row("used by", used(r))
        return Group(grid, hint(("d", "remove"), ("p", "pull latest")))

    if row.kind == "volume":
        r = row.res
        grid.add_row("volume", Text(r.id, style="bold", overflow="fold"))
        if r.extra.get("anonymous"):
            grid.add_row("type", "anonymous (created automatically for a container)")
        grid.add_row("size", fmt_size(r.size) if r.size else "—")
        if r.project:
            grid.add_row("stack", r.project)
        grid.add_row("driver", str(r.extra.get("driver", "")))
        grid.add_row("mountpoint", Text(str(data.get("Mountpoint") or r.extra.get("mountpoint", "")), overflow="fold"))
        if data.get("CreatedAt"):
            grid.add_row("created", str(data["CreatedAt"])[:19].replace("T", " "))
        grid.add_row("used by", used(r))
        return Group(grid, hint(("d", "remove (deletes its data)"), ("P", "clean up unused")))

    if row.kind == "network":
        r = row.res
        grid.add_row("network", Text(r.name, style="bold"))
        grid.add_row("id", r.id)
        grid.add_row("driver", f"{r.extra.get('driver', '')}   scope {r.extra.get('scope', '')}"
                     + ("   internal" if r.extra.get("internal") else ""))
        if r.project:
            grid.add_row("stack", r.project)
        cfgs = ((data.get("IPAM") or {}).get("Config") or [])
        if cfgs:
            grid.add_row("subnet", "  ".join(f"{c.get('Subnet', '')} gw {c.get('Gateway', '')}".strip() for c in cfgs))
        attached = data.get("Containers") or {}
        if attached:
            grid.add_row("containers", "\n".join(f"{v.get('Name')}  {str(v.get('IPv4Address', '')).split('/')[0]}"
                                                 for v in attached.values()))
        else:
            none = "none (built-in network)" if r.extra.get("builtin") else "none"
            grid.add_row("containers", Text(none, style=MUTED))
        return Group(grid, hint(("d", "remove"),))

    c = row.container
    if not data:
        grid.add_row("name", c.name)
        grid.add_row("status", c.status)
        return grid
    cfg, st = data.get("Config", {}), data.get("State", {})
    hc, net = data.get("HostConfig", {}), data.get("NetworkSettings", {})
    grid.add_row("name", Text(c.name, style="bold"))
    grid.add_row("id", c.id)
    grid.add_row("image", cfg.get("Image") or c.image)
    status = fmt_status(c.status, c.state)
    if st.get("Health"):
        status.append(f"   health {st['Health'].get('Status')}", style=MUTED)
    grid.add_row("status", status)
    if c.project:
        grid.add_row("compose", f"{c.project} / {c.service}")
    grid.add_row("created", str(data.get("Created", ""))[:19].replace("T", " "))
    cmd = " ".join([str(data.get("Path", ""))] + [str(a) for a in data.get("Args") or []])
    grid.add_row("command", Text(cmd, overflow="fold"))
    grid.add_row("ports", fmt_ports(c.ports, published_only=False) or "—")
    nets = net.get("Networks") or {}
    if nets:
        grid.add_row("networks", "  ".join(f"{n} {v.get('IPAddress') or ''}".strip() for n, v in nets.items()))
    mounts = data.get("Mounts") or []
    if mounts:
        lines = []
        for m in mounts:
            src = m.get("Name") if m.get("Type") == "volume" else tilde(str(m.get("Source", "")))
            lines.append(f"{src} → {m.get('Destination')}{'' if m.get('RW', True) else ' (ro)'}")
        grid.add_row("mounts", "\n".join(lines))
    rp = (hc.get("RestartPolicy") or {}).get("Name")
    if rp:
        grid.add_row("restart", rp)
    if c.id in app.stats:
        cpu, mem = app.stats[c.id]
        grid.add_row("cpu / mem", f"{cpu}  ·  {mem}")
    return grid


