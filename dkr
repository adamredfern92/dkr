COMPOSE_FILES = ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")
L_PROJECT = "com.docker.compose.project"
L_SERVICE = "com.docker.compose.service"
L_WORKDIR = "com.docker.compose.project.working_dir"
L_FILES = "com.docker.compose.project.config_files"
L_NUMBER = "com.docker.compose.container-number"
BUILTIN_NETWORKS = {"bridge", "host", "none", "podman"}


@dataclass
class Engine:
    name: str  # "docker" | "podman"
    compose: list[str]  # e.g. ["docker", "compose"]

    @property
    def fmt(self) -> str:
        """--format value that yields JSON (one object per line for docker, an array for podman)."""
        return "json" if self.name == "podman" else "{{json .}}"


def detect_engine() -> Engine:
    want = os.environ.get("DKR_ENGINE")
    order = [want] if want else ["docker", "podman"]
    for name in order:
        if name and shutil.which(name):
            if name == "podman" and not _has_subcommand("podman", "compose") and shutil.which("podman-compose"):
                return Engine(name, ["podman-compose"])
            return Engine(name, [name, "compose"])
    sys.exit("dkr: neither docker nor podman found on PATH (set DKR_ENGINE to override)")


def _has_subcommand(cmd: str, sub: str) -> bool:
    try:
        return subprocess.run([cmd, sub, "version"], capture_output=True, timeout=5).returncode == 0
    except Exception:
        return False


def run(cmd: list[str], timeout: float = 30, cwd: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)


def run_json(cmd: list[str], timeout: float = 30) -> list[dict]:
    """Run a command whose output is JSON lines or a JSON array; return a list of objects."""
    r = run(cmd, timeout=timeout)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or f"{' '.join(cmd[:3])} failed")
    out = r.stdout.strip()
    if not out:
        return []
    if out.startswith("["):
        return json.loads(out)
    return [json.loads(line) for line in out.splitlines() if line.strip()]


def pick(d: dict, *keys, default=""):
    """First present, non-empty value among `keys` (docker and podman name things differently)."""
    for k in keys:
        v = d.get(k)
        if v not in (None, "", "N/A"):
            return v
    return default


@dataclass
class Container:
    id: str
    name: str
    image: str
    state: str  # running | exited | paused | restarting | created | dead
    status: str  # human status from the engine, e.g. "Up 2 hours (healthy)"
    ports: str  # raw ports string, e.g. "0.0.0.0:8080->80/tcp, [::]:8080->80/tcp"
    labels: dict[str, str] = field(default_factory=dict)
    command: str = ""
    created: str = ""
    mounts: list[str] = field(default_factory=list)  # volume names / bind paths
    networks: list[str] = field(default_factory=list)

    @property
    def project(self) -> str | None:
        return self.labels.get(L_PROJECT) or None

    @property
    def service(self) -> str | None:
        return self.labels.get(L_SERVICE) or None

    @property
    def running(self) -> bool:
        return self.state == "running"


_LABEL_SPLIT = re.compile(r",(?=[\w.\-/]+=)")


def parse_labels(raw) -> dict[str, str]:
    """Docker gives labels as one comma-joined string (values may contain commas); podman gives a dict."""
    if isinstance(raw, dict):
        return {str(k): str(v) for k, v in raw.items()}
    out: dict[str, str] = {}
    for part in _LABEL_SPLIT.split(raw or ""):
        if "=" in part:
            k, v = part.split("=", 1)
            out[k] = v
    return out


def _as_list(raw) -> list[str]:
    if isinstance(raw, list):
        return [str(x) for x in raw]
    return [x.strip() for x in str(raw or "").split(",") if x.strip()]


def _podman_ports(ports) -> str:
    if not isinstance(ports, list):
        return str(ports or "")
    bits = []
    for p in ports:
        proto = p.get("protocol", "tcp")
        host_ip = p.get("host_ip") or "0.0.0.0"
        hp, cp, rng = p.get("host_port"), p.get("container_port"), int(p.get("range") or 1)
        hps = f"{hp}-{hp + rng - 1}" if rng > 1 and hp else str(hp)
        cps = f"{cp}-{cp + rng - 1}" if rng > 1 else str(cp)
        bits.append(f"{host_ip}:{hps}->{cps}/{proto}" if hp else f"{cps}/{proto}")
    return ", ".join(bits)


def parse_container(d: dict) -> Container:
    names = d.get("Names", "")
    if isinstance(names, list):
        names = names[0] if names else ""
    cmd = d.get("Command", "")
    if isinstance(cmd, list):
        cmd = " ".join(cmd)
    state = str(d.get("State", "")).lower()
    status = d.get("Status") or state.capitalize()
    return Container(
        id=str(d.get("ID") or d.get("Id") or "")[:12],
        name=str(names).lstrip("/"),
        image=str(d.get("Image", "")),
        state=state,
        status=str(status),
        ports=_podman_ports(d.get("Ports")) if isinstance(d.get("Ports"), list) else str(d.get("Ports") or ""),
        labels=parse_labels(d.get("Labels")),
        command=str(cmd).strip('"'),
        created=str(d.get("CreatedAt") or d.get("Created") or ""),
        mounts=_as_list(d.get("Mounts")),
        networks=_as_list(d.get("Networks")),
    )


def list_containers(engine: Engine) -> list[Container]:
    return [parse_container(d) for d in run_json([engine.name, "ps", "-a", "--no-trunc", "--format", engine.fmt])]


def list_stats(engine: Engine) -> dict[str, tuple[str, str]]:
    """id -> (cpu%, mem used). Slow-ish (~2s), call from a background thread."""
    r = run([engine.name, "stats", "--no-stream", "--format", "{{json .}}"], timeout=20)
    stats: dict[str, tuple[str, str]] = {}
    if r.returncode != 0:
        return stats
    for line in r.stdout.splitlines():
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        cid = str(d.get("ID") or d.get("ContainerID") or d.get("Id") or "")[:12]
        mem = str(d.get("MemUsage") or d.get("mem_usage") or "").split("/")[0].strip()
        stats[cid] = (str(d.get("CPUPerc") or d.get("cpu_percent") or "").strip(), mem.replace("iB", "B"))
    return stats


def inspect(engine: Engine, kind: str, ident: str) -> dict:
    sub = {"container": [], "image": ["image"], "volume": ["volume"], "network": ["network"]}[kind]
    r = run([engine.name, *sub, "inspect", ident])
    if r.returncode != 0:
        return {}
    data = json.loads(r.stdout or "[]")
    return data[0] if data else {}


def engine_version(engine: Engine) -> str:
    for fmt in ("{{.Server.Version}}", "{{.Client.Version}}"):
        try:
            r = run([engine.name, "version", "--format", fmt], timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        except Exception:
            pass
    return "?"


# ── Images / volumes / networks ─────────────────────────────────────────────

_SIZE = re.compile(r"([\d.]+)\s*([kKMGTP]?i?B)")
_MULT = {"B": 1, "KB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12, "PB": 1e15,
         "KIB": 1024, "MIB": 1024**2, "GIB": 1024**3, "TIB": 1024**4}


def parse_size(s) -> int:
    if isinstance(s, (int, float)):
        return int(s)
    m = _SIZE.search(str(s or ""))
    return int(float(m.group(1)) * _MULT.get(m.group(2).upper(), 1)) if m else 0


def fmt_size(n: int) -> str:
    if n <= 0:
        return "0 B"
    for unit, mult in (("TB", 1e12), ("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
        if n >= mult:
            v = n / mult
            return f"{v:.1f} {unit}" if v < 100 else f"{v:.0f} {unit}"
    return f"{n} B"


@dataclass
class Resource:
    kind: str  # image | volume | network
    id: str  # what to pass to inspect / rm
    name: str
    size: int = 0  # bytes (0 = unknown)
    used_by: list[str] = field(default_factory=list)  # container names
    labels: dict[str, str] = field(default_factory=dict)
    created: str = ""
    extra: dict = field(default_factory=dict)  # kind-specific: tag, driver, scope, anonymous, dangling…

    @property
    def project(self) -> str | None:
        return self.labels.get(L_PROJECT) or None

    @property
    def in_use(self) -> bool:
        return bool(self.used_by) or bool(self.extra.get("count")) or bool(self.extra.get("builtin"))


@dataclass
class Resources:
    images: list[Resource] = field(default_factory=list)
    volumes: list[Resource] = field(default_factory=list)
    networks: list[Resource] = field(default_factory=list)
    build_cache: int = 0  # reclaimable bytes
    loaded: bool = False


def image_refs(repo: str, tag: str, iid: str) -> set[str]:
    refs = {iid[:12], "sha256:" + iid}
    if repo and repo != "<none>":
        refs.add(f"{repo}:{tag}")
        if tag == "latest":
            refs.add(repo)
        if repo.startswith("docker.io/library/"):
            short = repo.removeprefix("docker.io/library/")
            refs |= {f"{short}:{tag}", short if tag == "latest" else ""}
    return refs - {""}


def load_resources(engine: Engine, containers: list[Container]) -> Resources:
    res = Resources(loaded=True)
    df: dict = {}
    if engine.name == "docker":
        try:  # one call gives image container-counts, volume sizes/links and build cache (~1s)
            out = run([engine.name, "system", "df", "-v", "--format", "{{json .}}"], timeout=60)
            df = json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else {}
        except Exception:
            df = {}

    # images
    raw_images = df.get("Images") or run_json([engine.name, "image", "ls", "--format", engine.fmt])
    for d in raw_images:
        iid = str(pick(d, "ID", "Id")).removeprefix("sha256:")
        repo, tag = str(pick(d, "Repository", default="<none>")), str(pick(d, "Tag", default="<none>"))
        if repo == "<none>" and isinstance(d.get("RepoTags"), list) and d["RepoTags"]:  # podman
            repo, _, tag = d["RepoTags"][0].rpartition(":")
        refs = image_refs(repo, tag, iid)
        users = [c.name for c in containers if c.image in refs or c.image.removeprefix("sha256:")[:12] == iid[:12]]
        count = pick(d, "Containers", default=0)
        try:
            count = int(count)
        except (TypeError, ValueError):
            count = 0
        dangling = repo == "<none>"
        res.images.append(Resource(
            "image", iid[:12], f"{repo}:{tag}" if not dangling else "<untagged>",
            size=parse_size(pick(d, "UniqueSize", "Size", default=0)) or parse_size(pick(d, "Size", default=0)),
            used_by=users, created=str(pick(d, "CreatedSince", "CreatedAt", "Created")),
            extra={"count": max(count, len(users)), "dangling": dangling,
                   "total": parse_size(pick(d, "Size", default=0)), "repo": repo, "tag": tag}))

    # volumes
    raw_vols = df.get("Volumes") or run_json([engine.name, "volume", "ls", "--format", engine.fmt])
    for d in raw_vols:
        name = str(pick(d, "Name"))
        labels = parse_labels(d.get("Labels"))
        anonymous = "com.docker.volume.anonymous" in labels or bool(re.fullmatch(r"[0-9a-f]{64}", name))
        users = [c.name for c in containers if name in c.mounts]
        links = pick(d, "Links", default=0)
        try:
            links = int(links)
        except (TypeError, ValueError):
            links = 0
        res.volumes.append(Resource(
            "volume", name, name[:12] if anonymous else name, size=parse_size(pick(d, "Size", default=0)),
            used_by=users, labels=labels,
            extra={"count": max(links, len(users)), "anonymous": anonymous,
                   "driver": pick(d, "Driver", default="local"), "mountpoint": pick(d, "Mountpoint")}))

    # networks
    for d in run_json([engine.name, "network", "ls", "--format", engine.fmt]):
        name = str(pick(d, "Name", "name"))
        users = [c.name for c in containers if name in c.networks]
        res.networks.append(Resource(
            "network", str(pick(d, "ID", "id", default=name))[:12], name, used_by=users,
            labels=parse_labels(d.get("Labels") or d.get("labels")), created=str(pick(d, "CreatedAt", "created")),
            extra={"driver": pick(d, "Driver", "driver"), "scope": pick(d, "Scope", default="local"),
                   "builtin": name in BUILTIN_NETWORKS, "internal": str(pick(d, "Internal", "internal")) == "true"}))

    res.build_cache = sum(parse_size(b.get("Size")) for b in df.get("BuildCache") or []
                          if str(b.get("InUse")).lower() != "true")
    return res


def scope_resources(items: list[Resource], project: str | None, containers: list[Container]) -> list[Resource]:
    """Restrict to what belongs to one compose project: its labels, or used by its containers.

    Users outside the stack are summarised as a count (extra["elsewhere"]) rather than listed.
    """
    if not project:
        return items
    mine = {c.name for c in containers if c.project == project}
    out = []
    for r in items:
        ours = r.project == project or bool(mine & set(r.used_by))
        built = r.kind == "image" and str(r.extra.get("repo", "")).startswith(f"{project}-")
        if ours or built:  # compose-built images are named <project>-<service>
            local = [u for u in r.used_by if u in mine]
            out.append(replace(r, used_by=local, extra={**r.extra, "elsewhere": len(r.used_by) - len(local),
                                                         "count": len(local) or r.extra.get("count", 0)}))
    return out


# ── Clean-up plan ───────────────────────────────────────────────────────────


@dataclass
class PruneItem:
    key: str
    title: str
    explain: str
    cmd: list[str]
    count: int = 0
    size: int = 0
    names: list[str] = field(default_factory=list)
    warn: str = ""
    on: bool = False


def build_prune_plan(engine: Engine, containers: list[Container], res: Resources) -> list[PruneItem]:
    e = engine.name
    stopped = [c for c in containers if c.state in ("exited", "created", "dead")]
    dangling = [i for i in res.images if i.extra.get("dangling") and not i.in_use]
    unused_imgs = [i for i in res.images if not i.in_use]
    unused_nets = [n for n in res.networks if not n.in_use]
    unused_vols = [v for v in res.volumes if not v.in_use]
    items = [
        PruneItem("containers", "Stopped containers",
                  "Removes containers that aren't running. Their images and named volumes are kept; "
                  "compose recreates its containers on the next `up`.",
                  [e, "container", "prune", "-f"], len(stopped), 0, [c.name for c in stopped], on=True),
        PruneItem("dangling", "Dangling images",
                  "Untagged image layers left behind by rebuilds and re-pulls. Nothing uses them.",
                  [e, "image", "prune", "-f"], len(dangling), sum(i.size for i in dangling),
                  [i.id for i in dangling], on=True),
        PruneItem("images", "All unused images",
                  "Every image no container uses — including tagged ones like postgres:16. "
                  "They'll be pulled or rebuilt again the next time something needs them.",
                  [e, "image", "prune", "-a", "-f"], len(unused_imgs), sum(i.size for i in unused_imgs),
                  [i.name if i.name != "<untagged>" else i.id for i in unused_imgs]),
        PruneItem("networks", "Unused networks",
                  "Custom networks no container is attached to. Compose recreates them on `up`.",
                  [e, "network", "prune", "-f"], len(unused_nets), 0, [n.name for n in unused_nets], on=True),
        PruneItem("volumes", "Unused volumes",
                  "Volumes no container is using — this is where databases and uploads live.",
                  [e, "volume", "prune", "-f"] if e == "podman" else [e, "volume", "prune", "-a", "-f"],
                  len(unused_vols), sum(v.size for v in unused_vols),
                  [v.name + (" (anonymous)" if v.extra.get("anonymous") else "") for v in unused_vols],
                  warn="Deletes the data inside them. This can't be undone."),
    ]
    if e == "docker":
        items.append(PruneItem("cache", "Build cache",
                               "Cached layers from `docker build`. Safe to remove; the next build will be slower.",
                               [e, "builder", "prune", "-a", "-f"], 0, res.build_cache, on=True))
    return items


# ── Compose projects ────────────────────────────────────────────────────────


@dataclass
class Project:
    name: str
    working_dir: str = ""
    config_files: list[str] = field(default_factory=list)
    services: dict[str, dict] = field(default_factory=dict)  # declared services (only known for the cwd project)
    is_cwd: bool = False


def find_compose_file(start: Path | None = None) -> Path | None:
    d = (start or Path.cwd()).resolve()
    for folder in (d, *d.parents):
        for fname in COMPOSE_FILES:
            if (folder / fname).is_file():
                return folder / fname
    return None


def load_cwd_project(engine: Engine, start: Path | None = None) -> Project | None:
    f = find_compose_file(start)
    if not f:
        return None
    proj = Project(name=f.parent.name.lower(), working_dir=str(f.parent), config_files=[str(f)], is_cwd=True)
    try:
        r = run(engine.compose + ["-f", str(f), "config", "--format", "json"], cwd=str(f.parent), timeout=20)
        if r.returncode == 0:
            cfg = json.loads(r.stdout)
            proj.name = cfg.get("name") or proj.name
            proj.services = cfg.get("services") or {}
    except Exception:
        pass
    return proj


def collect_projects(containers: list[Container], cwd_project: Project | None) -> dict[str, Project]:
    projects: dict[str, Project] = {}
    if cwd_project:
        projects[cwd_project.name] = cwd_project
    for c in containers:
        if not c.project or c.project in projects:
            continue
        files = [x for x in c.labels.get(L_FILES, "").split(",") if x]
        projects[c.project] = Project(c.project, c.labels.get(L_WORKDIR, ""), files)
    return projects


def compose_base(engine: Engine, p: Project) -> tuple[list[str], str | None]:
    """Command prefix + cwd to run compose against project `p` from anywhere."""
    cmd = list(engine.compose) + ["-p", p.name]
    files = [f for f in p.config_files if Path(f).is_file()]
    for f in files:
        cmd += ["-f", f]
    wd = p.working_dir if p.working_dir and Path(p.working_dir).is_dir() else None
    if wd and files and engine.compose != ["podman-compose"]:
        cmd += ["--project-directory", wd]
    return cmd, wd


# ── Formatting ──────────────────────────────────────────────────────────────

# One accent, grey for everything secondary, red/green/yellow only when they mean something.
ACCENT = "cyan"
MUTED = "#a0a0a0"
OK, BAD, WARN = "green", "red", "yellow"

_UNITS = {"second": "s", "minute": "m", "hour": "h", "day": "d", "week": "w", "month": "mo", "year": "y"}
_DUR = re.compile(r"(about\s+)?(an?|\d+|less than an?)\s+(second|minute|hour|day|week|month|year)s?", re.I)


def short_duration(s: str) -> str:
    m = _DUR.search(s)
    if not m:
        return ""
    qty = m.group(2).lower()
    unit = _UNITS[m.group(3).lower()]
    if qty.startswith("less"):
        return f"<1{unit}"
    return f"{1 if qty in ('a', 'an') else qty}{unit}"


def fmt_status(status: str, state: str) -> Text:
    s = status or state
    low = s.lower()
    if "paused" in low:
        return Text("paused", style=WARN)
    if low.startswith("restarting"):
        return Text("restarting", style=WARN)
    if low.startswith("up"):
        t = Text(short_duration(s) or "up")
        if "(healthy)" in low:
            t.append(" ✓", style=OK)
        elif "unhealthy" in low:
            t.append(" ✗ unhealthy", style=BAD)
        elif "starting" in low:
            t.append(" … starting", style=WARN)
        return t
    m = re.match(r"exited \((-?\d+)\)", low)
    if m:
        code = int(m.group(1))
        ago = short_duration(s)
        t = Text(f"exit {code}", style=BAD if code not in (0, 130, 137, 143) else MUTED)
        if ago:
            t.append(f" · {ago} ago", style=MUTED)
        return t
    if low.startswith("created"):
        return Text("created", style=MUTED)
    return Text(s, style=MUTED)


def fmt_ports(raw: str, published_only: bool = True) -> str:
    """'0.0.0.0:8080->80/tcp, [::]:8080->80/tcp, 9000/tcp' -> '8080→80' (dedupes v4/v6, drops /tcp)."""
    seen: list[str] = []
    for part in (p.strip() for p in (raw or "").split(",")):
        if not part:
            continue
        if "->" in part:
            host, ctr = part.split("->", 1)
            hport = host.rsplit(":", 1)[-1]
            ip = host.rsplit(":", 1)[0] if ":" in host else ""
            ctr_port, _, proto = ctr.partition("/")
            item = hport if hport == ctr_port else f"{hport}→{ctr_port}"
            if ip in ("127.0.0.1", "[::1]", "::1"):
                item = f"lo:{item}"
        else:
            if published_only:
                continue
            ctr_port, _, proto = part.partition("/")
            item = f"({ctr_port})"
        if proto and proto != "tcp":
            item += f"/{proto}"
        if item not in seen:
            seen.append(item)
    return "  ".join(seen)


def short_image(image: str) -> str:
    img = image.split("@", 1)[0]
    if img.startswith("sha256:"):
        return img[7:19]
    last = img.rsplit("/", 1)[-1]
    return last or image


def short_ago(s: str) -> str:
    d = short_duration(s)
    return f"{d} ago" if d else s


DOT = {"running": ("●", OK), "paused": ("●", WARN), "restarting": ("●", WARN),
       "exited": ("●", BAD), "dead": ("●", BAD), "created": ("○", MUTED), "missing": ("◌", MUTED)}


def state_dot(c: Container | None) -> Text:
    if c is None:
        return Text(*DOT["missing"])
    sym, style = DOT.get(c.state, ("○", MUTED))
    if c.state == "exited" and re.match(r"exited \((0|130|137|143)\)", c.status.lower()):
        sym, style = "○", MUTED
    return Text(sym, style=style)


def tilde(p: str, max_len: int = 0) -> str:
    home = str(Path.home())
    p = "~" + p[len(home):] if p.startswith(home) else p
    if max_len and len(p) > max_len:
        parts = p.split("/")
        tail = parts[-1]
        for part in reversed(parts[:-1]):
            if len(tail) + len(part) + 3 > max_len:
                break
            tail = f"{part}/{tail}"
        p = "…/" + tail if len(tail) + 2 <= max_len else "…" + p[-(max_len - 1):]
    return p


def names_preview(names: list[str], n: int = 4) -> str:
    if not names:
        return ""
    more = f" +{len(names) - n} more" if len(names) > n else ""
    return ", ".join(names[:n]) + more


# ── Row model shared by the TUI and `dkr ps` ────────────────────────────────


@dataclass
class Row:
    key: str
    kind: str  # "group" | "container" | "service" | "spacer" | "image" | "volume" | "network"
    project: Project | None = None
    container: Container | None = None
    service: str | None = None
    label: str = ""
    running: int = 0
    total: int = 0
    res: Resource | None = None


STANDALONE = "· standalone"


def build_rows(containers: list[Container], projects: dict[str, Project], show_stopped: bool = True,
               filt: str = "", only: str | None = None) -> list[Row]:
    """Container rows grouped by compose project. `only` limits to one project."""
    filt = filt.lower().strip()

    def match(c: Container | None, proj: str, svc: str = "") -> bool:
        if not filt:
            return True
        hay = " ".join([proj, svc, c.name if c else "", c.image if c else ""]).lower()
        return filt in hay

    groups: dict[str, list[Container]] = {}
    for c in containers:
        groups.setdefault(c.project or STANDALONE, []).append(c)
    for name, p in projects.items():
        if p.is_cwd:
            groups.setdefault(name, [])
    if only:
        groups = {k: v for k, v in groups.items() if k == only}

    def order(name: str) -> tuple:
        p = projects.get(name)
        return (0 if p and p.is_cwd else 2 if name == STANDALONE else 1, name)

    rows: list[Row] = []
    for gname in sorted(groups, key=order):
        proj = projects.get(gname)
        ctrs = sorted(groups[gname], key=lambda c: (c.service or c.name, int(c.labels.get(L_NUMBER, "1") or 1)))
        present = {c.service for c in ctrs}
        missing = [s for s in (proj.services if proj else {}) if s not in present]
        body: list[Row] = []
        for c in ctrs:
            if (show_stopped or c.running) and match(c, gname, c.service or ""):
                label = c.service or c.name
                if c.service and int(c.labels.get(L_NUMBER, "1") or 1) > 1:
                    label += f" #{c.labels[L_NUMBER]}"
                body.append(Row(c.id, "container", proj, c, c.service, label))
        if show_stopped:
            for s in missing:
                if match(None, gname, s):
                    body.append(Row(f"svc:{gname}:{s}", "service", proj, None, s, s))
        if not body and not (proj and proj.is_cwd and not filt):
            continue
        n_run = sum(1 for c in ctrs if c.running)
        rows.append(Row(f"grp:{gname}", "group", proj, label=gname, running=n_run, total=len(ctrs) + len(missing)))
        rows.extend(body)
    return rows


def resource_rows(items: list[Resource], filt: str = "") -> list[Row]:
    filt = filt.lower().strip()
    items = [r for r in items if not filt or filt in f"{r.name} {r.id} {' '.join(r.used_by)} {r.project or ''}".lower()]
    items.sort(key=lambda r: (not r.in_use, r.name == "<untagged>", r.name.lower()))
    return [Row(f"{r.kind}:{r.id}", r.kind, label=r.name, res=r) for r in items]


VIEW_COLUMNS = {
    "containers": ("name", "image", "status", "ports", "cpu", "mem"),
    "images": ("image", "id", "size", "created", "used by"),
    "volumes": ("volume", "stack", "size", "driver", "used by"),
    "networks": ("network", "driver", "scope", "stack", "containers"),
}


def row_cells(r: Row, stats: dict | None = None, selected: bool = False) -> list[Text]:
    """Cells for one row: marker+dot, then the view's columns."""
    def lead(dot: Text | None) -> Text:
        t = Text("▌ " if selected else "  ", style=ACCENT)
        return t.append_text(dot or Text(" "))

    blank = Text("")
    if r.kind == "spacer":
        return [blank] * 7
    if r.kind == "group":
        name = Text(r.label, style="bold")
        if r.project and r.project.is_cwd:
            name.append("  here", style=ACCENT)
        where = tilde(r.project.working_dir, 30) if r.project and r.label != STANDALONE else ""
        return [lead(None), name, Text(where, style=MUTED), Text(f"{r.running}/{r.total} up", style=MUTED),
                blank, blank, blank]
    if r.kind == "service":
        return [lead(state_dot(None)), Text(r.label, style=MUTED), blank, Text("not created", style=MUTED),
                blank, blank, blank]
    if r.kind == "container":
        c = r.container
        cpu, mem = (stats or {}).get(c.id, ("", "")) if c.running else ("", "")
        return [lead(state_dot(c)), Text(r.label, style="" if c.running else MUTED),
                Text(short_image(c.image), style=MUTED), fmt_status(c.status, c.state), Text(fmt_ports(c.ports)),
                Text(cpu, justify="right"), Text(mem, justify="right")]

    res = r.res
    dot = Text("●", style=OK) if res.in_use else Text("○", style=MUTED)
    used = Text(names_preview(res.used_by, 3)) if res.used_by else (
        Text(f"{res.extra['count']} container(s)") if res.extra.get("count") else Text("unused", style=MUTED))
    if res.extra.get("elsewhere"):
        used.append(f"  +{res.extra['elsewhere']} elsewhere", style=MUTED)
    name = Text(res.name, style="" if res.in_use else MUTED)
    size = Text(fmt_size(res.size) if res.size else "", justify="right")
    if r.kind == "image":
        return [lead(dot), name, Text(res.id, style=MUTED), size, Text(short_ago(res.created), style=MUTED), used]
    if r.kind == "volume":
        if res.extra.get("anonymous"):
            name.append("  anonymous", style=MUTED)
        return [lead(dot), name, Text(res.project or "", style=MUTED), size,
                Text(str(res.extra.get("driver", "")), style=MUTED), used]
    # network
    if res.extra.get("builtin"):
        dot = Text("○", style=MUTED)
        used = Text(names_preview(res.used_by, 3)) if res.used_by else Text("built-in", style=MUTED)
    return [lead(dot), name, Text(str(res.extra.get("driver", "")), style=MUTED),
            Text(str(res.extra.get("scope", "")), style=MUTED), Text(res.project or "", style=MUTED), used]


def render_ps(engine: Engine, show_stopped: bool, all_stacks: bool = False) -> None:
    console = Console()
    containers = list_containers(engine)
    cwd_project = load_cwd_project(engine)
    projects = collect_projects(containers, cwd_project)
    only = cwd_project.name if cwd_project and not all_stacks else None
    rows = build_rows(containers, projects, show_stopped, only=only)
    if not rows:
        console.print(Text("No containers." if show_stopped else "No running containers — try dkr ps -a", style=MUTED))
        return
    t = Table(box=None, show_header=True, header_style=MUTED, padding=(0, 3, 0, 0), pad_edge=False)
    for h in ("", "name", "image", "status", "ports", "id"):
        t.add_column(h, no_wrap=True, overflow="ellipsis")
    for i, r in enumerate(rows):
        c = row_cells(r)
        if r.kind == "group":
            if i:
                t.add_row()
            t.add_row(Text(""), c[1], c[2], c[3], Text(""), Text(""))
        else:
            t.add_row(c[0][2:], c[1], c[2], c[3], c[4], Text(r.container.id if r.container else "", style=MUTED))
    console.print()
    console.print(t)
    if only:
        console.print(Text(f"\nshowing stack “{only}” only — dkr ps -g for everything", style=MUTED))
    console.print()


