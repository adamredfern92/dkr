    from textual.binding import Binding
    from textual.containers import Horizontal, VerticalScroll
    from textual.screen import ModalScreen
    from textual.widgets import ContentSwitcher, DataTable, Input, RichLog, Static
    from textual.widgets.data_table import RowDoesNotExist

    def rule(title: Text | str = "", align: str = "center") -> Rule:
        return Rule(title, style=MUTED, characters="─", align=align)

    def hints(items: list[tuple[str, str]]) -> Text:
        t = Text(no_wrap=True, overflow="ellipsis")
        for i, (key, label) in enumerate(items):
            if i:
                t.append(" · ", style=MUTED)
            t.append(key)
            t.append(f" {label}", style=MUTED)
        return t

    HINTS = {
        "containers": [("s", "start"), ("x", "stop"), ("r", "restart"), ("e", "exec"), ("u", "up"),
                       ("D", "down"), ("b", "build"), ("d", "remove"), ("P", "clean up"), ("?", "more"), ("q", "quit")],
        "images": [("d", "remove"), ("p", "pull"), ("P", "clean up"), ("/", "filter"), ("?", "more"), ("q", "quit")],
        "volumes": [("d", "remove"), ("P", "clean up"), ("/", "filter"), ("?", "more"), ("q", "quit")],
        "networks": [("d", "remove"), ("P", "clean up"), ("/", "filter"), ("?", "more"), ("q", "quit")],
    }
    MORE = [("1-4", "views"), ("tab", "pane"), ("g", "this stack / all"), ("/", "filter"), ("U", "up service"),
            ("p", "pull"), ("z", "zoom"), ("a", "stopped"), ("t", "stats"), ("ctrl+p", "all commands")]

    class Confirm(ModalScreen[bool]):
        BINDINGS = [("y", "answer(True)"), ("n,escape", "answer(False)")]

        def __init__(self, message: Text) -> None:
            super().__init__()
            self.message = message

        def compose(self) -> ComposeResult:
            body = Text()
            body.append_text(self.message)
            body.append("\n\n")
            body.append("y", style=f"bold {ACCENT}")
            body.append(" confirm    ", style=MUTED)
            body.append("n", style="bold")
            body.append(" cancel", style=MUTED)
            yield Static(body, id="dialog")

        def action_answer(self, value: bool) -> None:
            self.dismiss(value)

    class Prune(ModalScreen[list]):
        """Pick what to clean up; every option says what it removes and what it costs you."""
        BINDINGS = [("up,k", "move(-1)"), ("down,j", "move(1)"), ("space", "toggle"),
                    ("enter", "go"), ("escape,q", "cancel")]

        def __init__(self, items: list[PruneItem]) -> None:
            super().__init__()
            self.items = items
            self.cursor = 0

        def compose(self) -> ComposeResult:
            with VerticalScroll(id="prune"):
                yield Static(id="prune-body")

        def on_mount(self) -> None:
            self.redraw()

        def redraw(self) -> None:
            head = Text()
            head.append("Clean up Docker\n", style="bold")
            head.append("Frees disk space across all of Docker, not just this stack.\n", style=MUTED)
            for i, (k, label) in enumerate((("↑↓", "move"), ("space", "toggle"), ("enter", "review"),
                                            ("esc", "cancel"))):
                if i:
                    head.append("  ·  ", style=MUTED)
                head.append(k)
                head.append(f" {label}", style=MUTED)
            head.append("\n")

            grid = Table.grid(padding=(0, 1))
            grid.add_column(width=2, no_wrap=True)  # cursor bar
            grid.add_column(width=3, no_wrap=True)  # checkbox
            grid.add_column(ratio=1)  # text — wraps within its own column
            for i, it in enumerate(self.items):
                sel = i == self.cursor
                stat = []
                if it.count:
                    stat.append(f"{it.count} item{'s' if it.count != 1 else ''}")
                if it.size:
                    stat.append(fmt_size(it.size))
                body = Text()
                body.append(it.title, style="bold" if sel else ("" if stat else MUTED))
                body.append("   ")
                body.append("  ·  ".join(stat) if stat else "nothing to remove", style="" if stat else MUTED)
                if it.warn:
                    body.append(f"\n⚠ {it.warn}", style=WARN)
                body.append(f"\n{it.explain}", style=MUTED)
                if it.names:
                    body.append(f"\n{names_preview(it.names, 5)}", style=MUTED)
                grid.add_row(Text(""), Text(""), Text(""))
                grid.add_row(Text("▌" if sel else " ", style=ACCENT),
                             Text("[x]" if it.on else "[ ]", style=ACCENT if it.on else MUTED), body)

            chosen = [it for it in self.items if it.on and (it.count or it.size)]
            covers = any(c.key == "images" for c in chosen)  # `image prune -a` includes dangling ones
            total = sum(it.size for it in chosen if not (it.key == "dangling" and covers))
            foot = Text("\n")
            foot.append(f"{len(chosen)} selected", style="bold")
            if total:
                foot.append(f"  ·  about {fmt_size(total)} to free", style="bold")
            self.query_one("#prune-body", Static).update(Group(head, grid, foot))

        def action_move(self, step: int) -> None:
            self.cursor = (self.cursor + step) % len(self.items)
            self.redraw()

        def action_toggle(self) -> None:
            it = self.items[self.cursor]
            it.on = not it.on
            self.redraw()

        def action_go(self) -> None:
            self.dismiss([it for it in self.items if it.on and (it.count or it.size)])

        def action_cancel(self) -> None:
            self.dismiss([])

