HELP = """[bold]dkr[/] — a readable dashboard for Docker / Podman + Compose

  [bold]dkr[/]                  full-screen dashboard
  [bold]dkr ps[/] [#a0a0a0][-a] [-g][/]      readable container list (-a include stopped, -g all stacks)
  [bold]dkr prune[/]            clean up disk space, with an explanation of each option
  [bold]dkr[/] [#a0a0a0]<args…>[/]          passthrough to `compose <args>` in a compose project, else `{engine} <args>`

  Inside a compose project dkr shows only that stack; press [bold]g[/] (or use -g) to see everything.

[bold]Dashboard keys[/]
  1-4 containers / images / volumes / networks      g this stack ↔ all
  s start   x stop   r restart   e exec shell   d remove   P clean up
  u compose up -d   U up selected service   D compose down   b build   p pull
  tab cycle details/logs/inspect   z zoom pane   / filter   a show/hide stopped
  t toggle CPU/mem   ctrl+p command palette   ? more keys   q quit

  Set DKR_ENGINE=podman to force podman.
"""


def main(argv: list[str]) -> None:
    if argv and argv[0] in ("-h", "--help", "help"):
        Console().print(HELP.replace("{engine}", "docker"))
        return
    engine = detect_engine()
    if not argv:
        if not sys.stdout.isatty():
            return render_ps(engine, show_stopped=True)
        return tui_main(engine)
    if argv[0] == "ps" and set(argv[1:]) <= {"-a", "--all", "-g", "--global", "-ag", "-ga"}:
        flags = "".join(a.lstrip("-") for a in argv[1:])
        return render_ps(engine, show_stopped="a" in flags or "all" in argv[1:],
                         all_stacks="g" in flags or "--global" in argv[1:])
    if argv[0] == "prune" and len(argv) == 1:
        return tui_main(engine, start_prune=True)
    cmd = engine.compose + argv if find_compose_file() else [engine.name] + argv
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        pass
    except RuntimeError as e:
        sys.exit(f"dkr: {e}")
