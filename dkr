            Binding("l", "pane('logs')"), Binding("i", "pane('inspect')"),
            Binding("tab", "cycle_pane", priority=True), Binding("shift+tab", "cycle_pane(-1)", priority=True),
            Binding("slash", "filter"), Binding("a", "toggle_stopped"), Binding("t", "toggle_stats"),
