        ]

        def __init__(self) -> None:
            super().__init__(ansi_color=True)
            self.engine = engine
            self.version = "…"
            self.view = "containers"
            self.containers: list[Container] = []
            self.by_id: dict[str, Container] = {}
            self.res = Resources()
            self.cwd_project: Project | None = None
            self.scoped = True  # inside a compose project: show only that stack
